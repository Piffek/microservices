<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        PARENT POM — koordynuje całość projektu.
        Multi-module Maven: jeden mvn package buduje wszystkie serwisy.
    -->
    <groupId>com.example</groupId>
    <artifactId>microservices</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>common</module>
        <module>order-service</module>
        <module>inventory-service</module>
        <module>notification-service</module>
    </modules>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.46</lombok.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <!--
            Nadpisujemy wersję Testcontainers zarządzaną przez Spring Boot (1.19.x):
            nowsze Docker Engine (minimalne API 1.44) nie współpracują ze starszymi wersjami,
            a ConfluentKafkaContainer jest dostępny dopiero od 1.20.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Byte Buddy (używany przez Mockito) z Boota 3.3.x nie obsługuje JDK 25 — wymagane do @MockBean na nowym JDK -->
        <byte-buddy.version>1.17.7</byte-buddy.version>
    </properties>

    <!-- Zależności wspólne dla wszystkich modułów -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                Testy integracyjne (*IT) uruchamia Failsafe w fazach integration-test/verify,
                testy jednostkowe (*Test) — Surefire w fazie test.
                "mvn test" jest więc szybkie i nie wymaga Dockera,
                a "mvn verify" uruchamia pełen zestaw z Testcontainers.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
